<Window x:Class="Trivia_Tracker.ViewModel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trivia_Tracker"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Trivia Tracker" Height="600"
        SizeToContent="Width"
        MinWidth="900"
        Background="#121212"
        materialDesign:ColorZoneAssist.Mode="Dark"> 
    
    
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#1e1e1e">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="NavList"
                     Grid.Row="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#e0e0e0"
                     SelectedIndex="0"
                     Padding="6"
                     SelectionChanged="NavList_SelectionChanged">

                <ListBox.Resources>
                    <!-- Base style for each nav item -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="8 6"/>
                        <Setter Property="Padding" Value="12 10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- Left accent bar -->
                                        <Border x:Name="Accent"
                                    Width="4"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"/>

                                        <!-- Main item surface -->
                                        <Border x:Name="Surface"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="6,0,0,0">
                                            <ContentPresenter />
                                        </Border>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <!-- Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#2a2a2a"/>
                                        </Trigger>

                                        <!-- Selected -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#323232"/>
                                            <Setter TargetName="Accent" Property="Background" Value="#7c4dff"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>

                                        <!-- Selected + Hover (optional subtle bump) -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Surface" Property="Background" Value="#3a3a3a"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Style for the text inside each item -->
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </ListBox.Resources>

                <!-- Items -->
                <ListBoxItem x:Name="AddGame">
                    <TextBlock Text="Add Game"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem x:Name="ViewStats">
                    <TextBlock Text="View Stats"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem Name="Players">
                    <TextBlock Text="Players"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem x:Name="Settings">
                    <TextBlock Text="Settings"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>
            </ListBox>
        </Grid>


        <!-- Main Content -->
        <ContentControl x:Name="MainContentHost" Grid.Column="1">
            <Grid Grid.Column="1" Background="#121212">
                <!-- card-like container -->
                <Border Background="#1f1f1f"
                        CornerRadius="8"
                        Padding="20"
                        Margin="20">
                    <ScrollViewer Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="Add New Game" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Margin="0 0 0 16" 
                                       Foreground="#ffffff"/>

                            <TextBlock Text="Date" Foreground="#e0e0e0" FontSize="15"/>
                            <DatePicker Margin="0 0 12 16" 
                                        Foreground="#e0e0e0"
                                        Background="#262626"
                                        materialDesign:TextFieldAssist.UnderlineBrush="{DynamicResource PrimaryHueMidBrush}" />

                            <TextBlock Text="Select Players" Foreground="#e0e0e0" FontSize="15"/>
                            <ListBox x:Name="PlayerListBox"
                                     ItemStringFormat="{Binding AllPlayers}"
                                     Margin="0 0 12 0"
                                     SelectionMode="Single"
                                     Height="100"
                                     Background="#262626"
                                     BorderBrush="#444"
                                     Foreground="White"
                                     materialDesign:ShadowAssist.Darken="True">
                                <!-- Placeholder items; later we’ll bind to the player list -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Foreground="White"
                                                  Margin="4 2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Round 1 -->
                            <Expander Header="Round 1" 
                                    Margin="0 8 12 0"
                                    Foreground="#e0e0e0"
                                    Background="#2a2a2a">
                                <StackPanel>
                                    <Grid x:Name="Round1Grid" Margin="8">
                                        <!-- shared styles just for this grid -->
                                        <Grid.Resources>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Margin" Value="4 2"/>
                                                <Setter Property="MinWidth" Value="80"/>
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                            </Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                                <Setter Property="Margin" Value="4 2"/>
                                            </Style>
                                        </Grid.Resources>

                                        <!-- columns: Q#, Category, Correct, P1..P4, Bonus -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <!-- Q# -->
                                            <ColumnDefinition Width="140"/>
                                            <!-- Category -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Correct -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Player 1 -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Player 2 -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Player 3 -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Player 4 -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- Bonus flag -->
                                        </Grid.ColumnDefinitions>

                                        <!-- rows: header + 4 questions -->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- header row -->
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- HEADER ROW -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Q#" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Category" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Correct" FontWeight="Bold"/>
                                        <TextBlock x:Name="Player1Header" Grid.Row="0" Grid.Column="3" Text="Player 1" FontWeight="Bold"/>
                                        <TextBlock x:Name="Player2Header" Grid.Row="0" Grid.Column="4" Text="Player 2" FontWeight="Bold"/>
                                        <TextBlock x:Name="Player3Header" Grid.Row="0" Grid.Column="5" Text="Player 3" FontWeight="Bold"/>
                                        <TextBlock x:Name="Player4Header" Grid.Row="0" Grid.Column="6" Text="Player 4" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="7" Text="Bonus"  FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                                        <!-- ROW: Q1 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="1"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1">
                                            <!-- placeholder items; later we’ll bind to Categories -->
                                            <ComboBoxItem Content="Movies"/>
                                            <ComboBoxItem Content="Science"/>
                                            <ComboBoxItem Content="History"/>
                                            <ComboBoxItem Content="Sports"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="2">
                                            <ComboBoxItem Content="A"/>
                                            <ComboBoxItem Content="B"/>
                                            <ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="3">
                                            <ComboBoxItem Content="A"/>
                                            <ComboBoxItem Content="B"/>
                                            <ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="4">
