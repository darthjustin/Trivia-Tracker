<Window x:Class="Trivia_Tracker.ViewModel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trivia_Tracker"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Trivia Tracker" Height="600"
        SizeToContent="Width"
        MinWidth="900"
        Background="#121212"
        materialDesign:ColorZoneAssist.Mode="Dark"> 
    
    
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#1e1e1e">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="NavList"
                     Grid.Row="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#e0e0e0"
                     Padding="6"
                     SelectionChanged="NavList_SelectionChanged">

                <ListBox.Resources>
                    <!-- Base style for each nav item -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="8 6"/>
                        <Setter Property="Padding" Value="12 10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- Left accent bar -->
                                        <Border x:Name="Accent"
                                    Width="4"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"/>

                                        <!-- Main item surface -->
                                        <Border x:Name="Surface"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="6,0,0,0">
                                            <ContentPresenter />
                                        </Border>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <!-- Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#2a2a2a"/>
                                        </Trigger>

                                        <!-- Selected -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#323232"/>
                                            <Setter TargetName="Accent" Property="Background" Value="#7c4dff"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>

                                        <!-- Selected + Hover (optional subtle bump) -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Surface" Property="Background" Value="#3a3a3a"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Style for the text inside each item -->
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </ListBox.Resources>

                <!-- Items -->
                <ListBoxItem x:Name="AddGame">
                    <TextBlock Text="Add Game"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem x:Name="ViewStats">
                    <TextBlock Text="View Stats"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem Name="Players">
                    <TextBlock Text="Players"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem x:Name="Settings">
                    <TextBlock Text="Settings"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ListBoxItem>
            </ListBox>
        </Grid>


        <!-- Main Content -->
        <ContentControl x:Name="MainContentHost" Grid.Column="1"/>
    </Grid>
</Window>