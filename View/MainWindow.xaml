                                            <ComboBoxItem Content="B"/>
                                            <ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="4" Grid.Column="6">
                                            <ComboBoxItem Content="A"/>
                                            <ComboBoxItem Content="B"/>
                                            <ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/>
                                        </ComboBox>
                                        <CheckBox Grid.Row="4" Grid.Column="7" ToolTip="Bonus used?"/>
                                    </Grid>

                                    <!-- DOUBLE DOWN SECTION -->
                                    <Border Margin="0 16 0 0"
                                            Background="#262626"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Double Down Dare"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Margin="0 0 0 8"
                                                       Foreground="#ffffff"/>
                                            <TextBlock Text="Correct Answer"
                                                       Foreground="#e0e0e0"/>
                                            <TextBox Margin="0 4 0 12"/>

                                            <TextBlock Text="Player Answers"
                                                       Margin=" 0 0 0 6"
                                                       Foreground="#e0e0e0"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <!-- player name -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- answer -->
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Player 1 -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Player 1" VerticalAlignment="Center" Foreground="#e0e0e0"/>
                                                <TextBox  Grid.Row="0" Grid.Column="1" Margin="0 2 0 2"/>

                                                <!-- Player 2 -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Player 2" VerticalAlignment="Center" Foreground="#e0e0e0"/>
                                                <TextBox  Grid.Row="1" Grid.Column="1" Margin="0 2 0 2"/>

                                                <!-- Player 3 -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Player 3" VerticalAlignment="Center" Foreground="#e0e0e0"/>
                                                <TextBox  Grid.Row="2" Grid.Column="1" Margin="0 2 0 2"/>

                                                <!-- Player 4 -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Player 4" VerticalAlignment="Center" Foreground="#e0e0e0"/>
                                                <TextBox  Grid.Row="3" Grid.Column="1" Margin="0 2 0 2"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Button Content="Save Game"
                                    Margin="0 20 12 0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="36" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ContentControl>
    </Grid>
</Window>