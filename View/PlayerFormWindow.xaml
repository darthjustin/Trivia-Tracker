<Window x:Class="Trivia_Tracker.View.PlayerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Player Details"
        Width="420"
        Height="360"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#121212">
    <Grid Background="#121212" Margin="16">
        <Border Background="#1f1f1f" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0 0 16 0" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="0 0 16 8">
                    <TextBlock x:Name="HeaderText"
                               Text="Add Player"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0 0 0 16"/>

                    <TextBlock Text="First Name" Foreground="#e0e0e0"/>
                    <TextBox x:Name="FirstNameTextBox"
                             Margin="0 4 0 12"
                             Background="#262626"
                             Foreground="White"
                             BorderBrush="#444"
                             BorderThickness="1"
                             Padding="10"
                             HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Last Name" Foreground="#e0e0e0"/>
                    <TextBox x:Name="LastNameTextBox"
                             Margin="0 4 0 12"
                             Background="#262626"
                             Foreground="White"
                             BorderBrush="#444"
                             BorderThickness="1"
                             Padding="10"
                             HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Username" Foreground="#e0e0e0"/>
                    <TextBox x:Name="UsernameTextBox"
                             Margin="0 4 0 16"
                             Background="#262626"
                             Foreground="White"
                             BorderBrush="#444"
                             BorderThickness="1"
                             Padding="10"
                             HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Created Date" Foreground="#e0e0e0"/>
                    <DatePicker x:Name="CreatedDatePicker"
                                Margin="0 4 0 20"
                                Background="#262626"
                                Foreground="White"
                                SelectedDate="{x:Static sys:DateTime.Now}"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Content="Cancel"
                                MinWidth="110"
                                Padding="12,8"
                                Background="#2a2a2a"
                                Foreground="White"
                                BorderBrush="#444"
                                BorderThickness="1"
                                Click="CancelButton_Click"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="Save"
                                MinWidth="110"
                                Padding="12,8"
                                Background="#2196F3"
                                Foreground="White"
                                BorderBrush="#2196F3"
                                Click="SaveButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
